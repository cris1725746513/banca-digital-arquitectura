flowchart LR
  classDef aws fill:#ff9900,stroke:#b36b00,color:#000
  classDef awsd fill:#232f3e,stroke:#000,color:#fff
  classDef sec fill:#dd344c,stroke:#8f1f2e,color:#fff
  classDef dato fill:#2f8f83,stroke:#1d5f57,color:#fff
  classDef onprem fill:#999999,stroke:#6b6b6b,color:#fff
  classDef ext fill:#e8e8e8,stroke:#999,color:#000
  classDef user fill:#08427b,stroke:#052e56,color:#fff

  usr(["<b>Clientes</b><br/>Navegador y app móvil<br/>(Ecuador)"]):::user
  op(["<b>Analistas</b><br/>Backoffice vía VPN corporativa"]):::user

  subgraph borde["Borde global"]
    direction LR
    r53["<b>Route 53</b><br/>DNS, health checks,<br/>failover"]:::aws
    cf["<b>CloudFront + WAF + Shield Advanced</b><br/>SPA estática desde S3"]:::aws
    ga["<b>Global Accelerator</b><br/>Entrada a la red de AWS<br/>cerca del usuario"]:::aws
  end

  subgraph prod["Cuenta Producción - Región primaria (us-east-1)"]
    subgraph vpc["VPC  ·  3 zonas de disponibilidad"]
      subgraph pub["Subredes públicas"]
        alb["<b>ALB + AWS WAF</b><br/>TLS 1.3"]:::aws
        nat["<b>NAT Gateways</b><br/>Salida controlada a<br/>proveedores externos"]:::aws
      end
      subgraph app["Subredes privadas de aplicación"]
        eks["<b>Amazon EKS</b> (3 AZ, nodos en varias familias)<br/>Kong Gateway · BFF · Servicios de dominio · Keycloak<br/>Istio (mTLS entre servicios) · HPA y KEDA"]:::aws
      end
      subgraph dat["Subredes privadas de datos"]
        aur["<b>Aurora PostgreSQL</b><br/>Multi-AZ: Transferencias,<br/>Onboarding, Auditoría, Identidad"]:::dato
        rds["<b>ElastiCache Redis</b><br/>Cluster mode con réplicas"]:::dato
        msk["<b>Amazon MSK</b><br/>3 brokers, 3 AZ"]:::dato
        ddb["<b>DynamoDB</b><br/>Lectura de movimientos<br/>(VPC endpoint)"]:::dato
      end
      tgw["<b>Transit Gateway</b>"]:::aws
    end
    mgd["<b>Servicios administrados</b><br/>S3 (evidencias, Object Lock) · SQS · SES · SNS<br/>Secrets Manager · KMS (claves por dominio) · CloudHSM"]:::aws
    obs["<b>Observabilidad</b><br/>OpenTelemetry · Prometheus y Grafana administrados<br/>CloudWatch · OpenSearch (logs)"]:::awsd
  end

  subgraph seg["Cuenta de Seguridad y Log Archive"]
    direction LR
    ct["<b>CloudTrail, Config, GuardDuty,<br/>Security Hub, Inspector</b><br/>Agregación organizacional"]:::sec
    arch["<b>S3 Object Lock</b> (modo compliance)<br/>Archivo de auditoría y logs"]:::sec
    siem["<b>SIEM / SOC 24x7</b>"]:::sec
  end

  subgraph dr["Cuenta Producción - Región DR (us-east-2), warm standby"]
    direction LR
    eks2["<b>EKS reducido</b><br/>Mismos manifiestos (GitOps)"]:::aws
    aur2["<b>Aurora Global Database</b><br/>Clúster secundario"]:::dato
    msk2["<b>MSK Replicator</b><br/>DynamoDB Global Tables,<br/>S3 CRR"]:::dato
  end

  subgraph dc["Datacenter del Banco (Ecuador)"]
    direction LR
    fw["<b>Firewall y segmentación</b>"]:::onprem
    integ["<b>Capa de Integración</b><br/>+ Conector CDC"]:::onprem
    core["<b>Core Bancario,<br/>Datos Extendidos,<br/>BD Principal</b>"]:::onprem
    spi["<b>Enlace al SPI-BCE</b>"]:::onprem
  end

  subgraph terc["Proveedores externos"]
    direction LR
    kyc["KYC y Biometría (SaaS)"]:::ext
    ntf["APNs / FCM · Agregador SMS"]:::ext
    ver["Registro Civil · AML/PEP"]:::ext
  end

  usr --> r53
  usr -- "Estáticos" --> cf
  usr -- "API" --> ga
  op -. "VPN" .-> alb
  r53 -.-> ga
  ga --> alb --> eks
  cf -. "origen S3" .-> mgd
  eks --> aur & rds & msk & ddb
  eks --> mgd
  eks --> nat
  nat --> terc
  eks -. "telemetría" .-> obs
  eks --- tgw
  tgw == "Direct Connect x2<br/>(ubicaciones distintas)<br/>+ VPN IPsec de respaldo" ==> fw
  fw --> integ --> core
  integ --> spi
  integ -. "CDC por Direct Connect" .-> msk

  aur -. "Replicación < 1 s" .-> aur2
  msk -.-> msk2
  eks2 --- aur2
  eks2 -. "Direct Connect propio" .-> fw
  r53 -. "Failover" .-> eks2

  obs -.-> ct
  mgd -.-> arch
  ct --> siem
